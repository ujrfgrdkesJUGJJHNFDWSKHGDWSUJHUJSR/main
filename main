--[[00fuscator layered VM payload: Base64 -> XOR -> LZ4 -> interpreter runtime]] return (function(...)   local __b=bit32   local __byte,__char,__sub=string.byte,string.char,string.sub   local __concat=table.concat   local function __fail()     pcall(function() if warn then warn("00fuscator: protected payload integrity check failed") end end)     return nil   end   local function __b64(s)     local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"     local lut={}     for i=1,#alphabet do lut[__byte(alphabet,i)]=i-1 end     local out={}     for i=1,#s,4 do       local a,b,c,d=lut[__byte(s,i)] or 0,lut[__byte(s,i+1)] or 0,lut[__byte(s,i+2)] or 0,lut[__byte(s,i+3)] or 0       local n=a*262144+b*4096+c*64+d       out[#out+1]=__char(__b.band(__b.rshift(n,16),255))       if __sub(s,i+2,i+2)~="=" then out[#out+1]=__char(__b.band(__b.rshift(n,8),255)) end       if __sub(s,i+3,i+3)~="=" then out[#out+1]=__char(__b.band(n,255)) end     end     return __concat(out)   end   local function __unmask(s)     local out={}     for i=1,#s do out[i]=__char(__b.bxor(__byte(s,i),(176+(i-1)*29)%256)) end     return __concat(out)   end   local function __lz4(s,expected)     if expected<0 or expected>1200000 then return nil end     if #s>1200000 then return nil end     local input={}     for i=1,#s do input[i]=__byte(s,i) end     local output,ip={},1     local function more(n)       local v=n       if n~=15 then return v end       while true do         local x=input[ip];ip=ip+1;if not x then return nil end         v=v+x;if x~=255 then return v end       end     end     while ip<=#input do       local token=input[ip];ip=ip+1;if not token then return nil end       local literal=more(__b.rshift(token,4));if not literal or ip+literal-1>#input or #output+literal>expected then return nil end       for _=1,literal do output[#output+1]=input[ip];ip=ip+1 end       if ip>#input then break end       local lo,hi=input[ip],input[ip+1];ip=ip+2;if not lo or not hi then return nil